{
  "name": "guild-war-egg2k",
  "private": true,
  "version": "1.0.0",
  "description": "EGG2K Guild War planner for Seven Knights Re:BIRTH (private, Discord + guild password)",
  "scripts": {
    "dev": "wrangler pages dev public --port 8788",
    "db:init:local": "wrangler d1 execute guild-war-egg2k --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute guild-war-egg2k --remote --file=schema.sql",
    "deploy": "wrangler pages deploy public --project-name guild-war-egg2k"
  },
  "devDependencies": {
    "wrangler": "^4.151.1"
  }
}
