/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self'; img-src 'self' data: https://cdn.discordapp.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow, noarchive
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets.json
  Cache-Control: no-cache

/vendor/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/favicon.svg
  Cache-Control: public, max-age=604800
